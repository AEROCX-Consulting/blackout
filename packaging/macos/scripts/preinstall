#!/bin/sh
# Draait als root vóór de installatie: stop een draaiende AEROCX Blackout,
# zodat de nieuwe versie de oude netjes vervangt.
LABEL="be.aerocx.blackout"

curl -fsS -m 3 -X POST http://127.0.0.1:8474/api/quit >/dev/null 2>&1 || true

USER_NAME=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ] && [ "$USER_NAME" != "loginwindow" ]; then
	USER_ID=$(id -u "$USER_NAME" 2>/dev/null || true)
	if [ -n "$USER_ID" ]; then
		launchctl bootout "gui/$USER_ID/$LABEL" >/dev/null 2>&1 || true
	fi
fi

sleep 1
pkill -x aerocx-blackout >/dev/null 2>&1 || true
exit 0
