<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>AEROCX Blackout</title>
    <organization>be.aerocx</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="default">
            <line choice="be.aerocx.blackout.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="be.aerocx.blackout.pkg" visible="false">
        <pkg-ref id="be.aerocx.blackout.pkg"/>
    </choice>
    <pkg-ref id="be.aerocx.blackout.pkg" version="@VERSION@" onConclusion="none">AEROCX-Blackout-app.pkg</pkg-ref>
</installer-gui-script>
